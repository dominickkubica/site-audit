# Crawl/PSI checkpoints - per-site, regenerable, and can contain a full
# snapshot of a client's site content
*.pkl

# PageSpeed Insights response cache (regenerable, 7-day TTL)
pagespeed_cache.json

# Places lookup cache - regenerable, but holds resolved business -> website
# mappings that cost money to rebuild and are nobody else's to have
places_cache.json

# Prospect lists and screening results. These carry third-party business
# contact data (names, addresses, phones) and private outreach tracking.
# Deliberately never committed - keep them local or in your CRM.
*.csv
*.csv.bak

# Generated reports - client deliverables, not source
*.pdf
# ...except the delivered v3 report, which is the regression baseline every
# verification diffs against (and the only artifact of real delivered work)
!rvivl_audit_report_v3.pdf

# Run logs
crawl_log.txt
*.log

# Secrets (PAGESPEED_API_KEY etc.)
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Virtualenvs
venv/
.venv/
env/

# Local tool/editor state
.claude/settings.local.json
.vscode/
.idea/
*.swp

# OS cruft
.DS_Store
Thumbs.db
desktop.ini
